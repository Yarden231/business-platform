# Local development environment.
#
#   cp .env.example .env
#
# Every value here is a development placeholder. Never put a real password,
# production credential, API key or Azure secret in this file — it is tracked by
# Git. `.env` is ignored by Git and is where local values belong.
#
# Docker Compose reads `.env` from the repository root automatically, and
# `./scripts/*` load it so that tooling running on the host (Alembic, pytest)
# sees the same values. Because the scripts source the file, a value containing
# a space or a semicolon must be quoted.
# Variables marked "not read by any code yet" exist because the Compose stack
# provisions the service now; the application starts consuming them later.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# development | production. The API enables its interactive /docs page only
# when this is not "production".
APP_ENV=development

# ---------------------------------------------------------------------------
# API service
# ---------------------------------------------------------------------------

# Host port the API is published on for developer diagnostics. The browser does
# not use this — it reaches the API through the web origin (see below).
API_PORT=8000

# uvicorn log level: critical | error | warning | info | debug | trace
API_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web service
# ---------------------------------------------------------------------------

# Host port the Next.js application is published on.
WEB_PORT=3000

# Server-side only. The origin the Next.js rewrite forwards /api/v1/* to, so the
# browser only ever talks to the web origin and session cookies stay first-party
# (ADR-0005). Inside Compose this is the `api` service; when running Next.js
# directly on the host it is http://localhost:8000.
API_INTERNAL_URL=http://api:8000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_DB=cohen_balancing
POSTGRES_USER=cohen
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432

# The host's view of the database, used by everything that runs outside the
# Compose network: ./scripts/migrate, ./scripts/test, alembic, pytest. The API
# container gets its own URL (the `db` service on port 5432) from
# docker-compose.yml, so this stays correct even if POSTGRES_PORT changes —
# keep the port here in step with POSTGRES_PORT above.
DATABASE_URL=postgresql+asyncpg://cohen:local_dev_password@localhost:5432/cohen_balancing

# Optional. Integration tests otherwise append `_test` to the database in
# DATABASE_URL, creating that database on first run. They never write to the
# development database.
# TEST_DATABASE_URL=postgresql+asyncpg://cohen:local_dev_password@localhost:5432/cohen_balancing_test

# ---------------------------------------------------------------------------
# Authentication, sessions and passwords
# ---------------------------------------------------------------------------
# Every value in this section has a working default in app/core/settings.py, so
# all of them stay commented out here. They are listed because they are the
# security knobs an operator is entitled to know exist, and because the numbers
# are policy rather than implementation — see docs/security.md §2 and §3.

# A development placeholder, and deliberately not a secret: it is published
# here, and APP_ENV=production refuses to start while it is still this value or
# shorter than 32 characters. Nothing in the authentication path currently
# consumes it — session and CSRF tokens are random opaque values checked against
# the database, so there is no signing key to keep — but the validation is in
# place for the day something needs one.
SESSION_SECRET=development-only-session-secret-not-for-production

# Session lifetime (docs/open-questions.md Q10: 8 hours idle, 12 absolute).
# A session dies at whichever limit it reaches first.
# SESSION_IDLE_TIMEOUT_SECONDS=28800
# SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200

# How often an active session's last_seen_at is written back. Without this,
# every authenticated request would UPDATE the session row.
# SESSION_LAST_SEEN_REFRESH_SECONDS=60

# The `Secure` cookie attribute. It defaults to off in development because
# local development is plain HTTP, and on in production — where the setting
# refuses to be turned off at all, so this cannot be the mistake that ships.
# SESSION_COOKIE_SECURE=false

# Brute-force controls. Per identity: N consecutive failures lock the identity
# for the cooling period. Per IP: N failures in the window return 429, which is
# what catches one address spraying many accounts.
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# LOGIN_IP_MAX_FAILED_ATTEMPTS=20
# LOGIN_IP_WINDOW_SECONDS=900

# Argon2id cost. Tune on the hardware that will run it: raise memory first, and
# keep hashing under ~500 ms so login stays usable. Raising these later is safe
# — an existing hash records the parameters it was made with and is upgraded in
# place the next time its owner logs in.
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=4

# Read only by ./scripts/create-admin, and only to avoid an interactive prompt
# in a provisioning script. Leave them unset and it asks at the terminal, which
# is the better habit: a password in an environment variable is a password in a
# shell history. There is no default administrator.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_FULL_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Azurite (Azure Blob Storage emulator)
# ---------------------------------------------------------------------------
# The account name and key below are Microsoft's published, well-known Azurite
# *emulator* credentials. They are identical on every developer machine, grant
# access to nothing outside the local container, and must never appear in any
# environment other than local development.

AZURITE_BLOB_PORT=10000

# Not read by any code yet (Phase 6). Quoted because it contains semicolons.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;"
