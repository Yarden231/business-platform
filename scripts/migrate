#!/usr/bin/env bash
#
# Bring the configured database up to the latest migration.
#
# Migrations are the only way schema reaches a database in this project; nothing
# calls Base.metadata.create_all(). The database is the one in DATABASE_URL
# (.env), which on a developer machine is the Compose `db` service seen from the
# host.
#
# Other Alembic commands are run directly, from apps/api:
#
#   uv run alembic downgrade -1          # undo the most recent migration
#   uv run alembic downgrade base        # empty the schema entirely
#   uv run alembic current               # which revision the database is at
#   uv run alembic history               # the revisions that exist
#   uv run alembic revision --autogenerate -m "add cases"
#
# Autogenerated revisions are a starting point, never the final artefact: read
# the migration, name its constraints, and check that a downgrade really is the
# inverse of the upgrade.

set -euo pipefail
# shellcheck source=scripts/_lib.sh
source "$(dirname "$0")/_lib.sh"

require_installed_dependencies
load_env
require_database

section "Applying migrations"
cd "${REPO_ROOT}/apps/api"
uv run alembic upgrade head

section "Current revision"
uv run alembic current
